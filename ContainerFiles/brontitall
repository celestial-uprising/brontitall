FROM fedora:rawhide

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true" \
      org.opencontainers.image.title="brontitall" \
      org.opencontainers.image.description="A distrobox image for building and running llama.cpp (Vulkan) with AOCC v6"

RUN dnf -y update && \
    dnf -y install --setopt=install_weak_deps=False \
    git curl wget gcc gcc-c++ gcc-gfortran cmake ninja-build make pkgconf \
    lld libomp libomp-devel glibc-devel libstdc++-devel openssl-devel vim \
    vulkan-loader vulkan-loader-devel vulkan-headers vulkan-tools glslc \
    openblas openblas-devel mimalloc mimalloc-devel spirv-headers-devel \
    ccache libquadmath libquadmath-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf/*

COPY ContainerFiles/aocc-v6/aocc* /tmp/

RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV PATH="/opt/AMD/aocc-compiler-6.0.0/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/AMD/aocc-compiler-6.0.0/lib:${LD_LIBRARY_PATH}" \
    LANG=en_US.UTF-8

RUN echo "source /opt/AMD/aocc-compiler-6.0.0/setenv_AOCC.sh" >> /etc/bashrc
