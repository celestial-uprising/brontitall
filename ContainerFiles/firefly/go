# ==============================================================================
# Fedora:44 + AOCCv6 + Golang - by Celestial Uprising
# ==============================================================================
FROM fedora:44 AS builder
# ==============================================================================
RUN dnf install -y \
    libquadmath \
    ncurses \
    golang \
    git \
    make \
    pkgconf-pkg-config \
    glibc-devel \
    && dnf clean all
# ==============================================================================
COPY ContainerFiles/aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*
# ==============================================================================
ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
# ==============================================================================
ENV GOPATH="/go" \
    GOBIN="/out/bin" \
    GOMAXPROCS="16" \
    GOOS="linux" \
    GOARCH="amd64" \
    GOAMD64="v3" \
    CGO_ENABLED="0" \
    CC="aoc" \
    CXX="aoc++" \
    CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"
# ==============================================================================
RUN mkdir -p /out/bin
FROM builder AS compiler
WORKDIR /build
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/szktkfm/mdtt/cmd/mdtt@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/termkit/gama@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/jesseduffield/lazygit@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/charmbracelet/glow/v2@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/chojs23/ec/cmd/ec@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/alvinunreal/lazyskills/cmd/lazyskills@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/yutat23/lsoff@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/Ri4dH/failtrace/cmd/failtrace@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/pedrosousa13/onda@latest
# ==============================================================================
RUN go install -trimpath -ldflags="-s -w" github.com/halpworld/halpradio@latest 
# ==============================================================================
# --- PATTERN B: Clone & Build a Custom GitHub Repo (e.g., projects with Makefiles or subpackages) ---
# RUN git clone --depth 1 https://github.com && \
#     cd go-repo && \
#     go build -trimpath -ldflags="-s -w" -o /out/bin/my-tool ./cmd/my-tool

# --- PATTERN C: Projects that REQUIRE CGO (e.g., SQLite / C bindings) ---
# (Override CGO_ENABLED=1 inline so AOCC 6.0 compiles the C bindings with znver3 flags)
# RUN CGO_ENABLED=1 go install -trimpath -ldflags="-s -w" ://github.com
# ==============================================================================
FROM scratch AS export
COPY --from=compiler /out/bin/ /usr/bin/
